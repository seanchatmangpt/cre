# AWS CI/CD configuration
# Source before running: source cicd/cloud/aws.env
#
# Required: Set AWS_ACCOUNT_ID and AWS_REGION
#
# Create ECR repo: aws ecr create-repository --repository-name cre
export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-123456789012}"
export AWS_REGION="${AWS_REGION:-us-east-1}"
export CICD_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
export CICD_IMAGE="cre"
export CICD_PUSH="${CICD_PUSH:-false}"
