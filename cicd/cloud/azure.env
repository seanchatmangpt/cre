# Azure CI/CD configuration
# Source before running: source cicd/cloud/azure.env
#
# Required: Set ACR_NAME (registry name)
#
# Create ACR: az acr create --resource-group mygroup --name myregistry --sku Basic
export ACR_NAME="${ACR_NAME:-myregistry}"
export CICD_REGISTRY="${ACR_NAME}.azurecr.io"
export CICD_IMAGE="cre"
export CICD_PUSH="${CICD_PUSH:-false}"
