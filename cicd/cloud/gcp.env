# GCP CI/CD configuration
# Source before running: source cicd/cloud/gcp.env
#
# Required: Set PROJECT_ID and optionally REGION
export PROJECT_ID="${PROJECT_ID:-your-project-id}"
export REGION="${REGION:-us-central1}"
export CICD_REGISTRY="${REGION}-docker.pkg.dev/${PROJECT_ID}/cre"
export CICD_IMAGE="cre"
export CICD_PUSH="${CICD_PUSH:-false}"
