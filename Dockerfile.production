# CRE Production Dockerfile (Simplified, uses main Dockerfile)
# This is a compatibility shim - the actual production Dockerfile is ./Dockerfile
# Build with: docker build -f Dockerfile -t cre:latest .
#
# For GCP Marketplace multi-arch builds, use docker-bake.hcl:
#   docker buildx bake --load cre

# Multi-stage production Dockerfile for CRE YAWL
# Stage 1: Build
FROM --platform=$BUILDPLATFORM erlang:28-alpine AS builder

ARG TARGETPLATFORM
ARG TARGETARCH
ARG BUILDPLATFORM
ARG VERSION=0.3.0
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown

# Install build dependencies
RUN apk add --no-cache \
    git \
    curl \
    build-base \
    openssl-dev \
    ca-certificates

# Install rebar3 with proper bootstrap
RUN git clone --depth 1 --branch 3.24.0 https://github.com/erlang/rebar3 /tmp/rebar3 && \
    cd /tmp/rebar3 && \
    ./bootstrap --bootstrapper sh && \
    mv rebar3 /usr/local/bin/rebar3 && \
    chmod +x /usr/local/bin/rebar3 && \
    rm -rf /tmp/rebar3 && \
    rebar3 version

# Set working directory
WORKDIR /build

# Copy project files
COPY rebar.config rebar.lock ./
COPY src ./src
COPY include ./include

# Install dependencies and compile
RUN rebar3 get-deps && \
    rebar3 compile && \
    rebar3 as prod tar

# Stage 2: Runtime
FROM --platform=$TARGETPLATFORM alpine:3.20

ARG VERSION=0.3.0
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown
ARG TARGETPLATFORM

# OCI metadata labels
LABEL org.opencontainers.image.title="CRE" \
      org.opencontainers.image.description="Common Runtime Environment for YAWL workflow engine" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/joergen7/cre" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="CRE Project" \
      org.opencontainers.image.platform="${TARGETPLATFORM}"

# Install runtime dependencies
RUN apk add --no-cache \
    openssl \
    ncurses-libs \
    libstdc++ \
    tzdata \
    curl \
    bash \
    ca-certificates

# Create non-root user with explicit UID/GID
RUN addgroup -g 1000 -S cre && \
    adduser -S -u 1000 -G cre -s /bin/bash -h /opt/cre cre

# Extract and install the release
COPY --from=builder --chown=cre:cre /build/_build/prod/rel/cre /opt/cre

# Copy entrypoint script
COPY --chown=cre:cre docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create directories for runtime data
RUN mkdir -p /opt/cre/data /opt/cre/log /opt/cre/checkpoints /opt/cre/mnesia && \
    chown -R cre:cre /opt/cre

# Switch to non-root user
USER 1000:1000
WORKDIR /opt/cre

# Expose CRE ports
# 4142 - CRE HTTP API
# 4369 - EPMD (Erlang Port Mapper Daemon)
# 9100-9200 - Distributed Erlang
EXPOSE 4142 4369 9100-9200

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:4142/api/v1/health || exit 1

# Signal handling for graceful shutdown
STOPSIGNAL SIGTERM

# Environment variables
ENV CRE_NODE_NAME=cre \
    CRE_HOSTNAME=cre \
    CRE_MODE=init \
    CRE_CLUSTER_PEERS="" \
    ERL_MAX_PORTS=65536 \
    ERL_MAX_ETS_TABLES=2000 \
    CRE_VERSION="${VERSION}" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Persistent data volumes
VOLUME ["/opt/cre/data", "/opt/cre/log", "/opt/cre/mnesia", "/opt/cre/checkpoints"]

# Use entrypoint script for proper initialization
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["foreground"]
