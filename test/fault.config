%% -------------------------------------------------------------------
%% @doc Fault Injection Test Configuration
%%
%% Common Test configuration for fault injection test suites.
%%
%% Usage:
%%   rebar3 ct --suite fault_kill_case_SUITE --config test/fault.config
%%
%% @end
%% -------------------------------------------------------------------

%% Log directory
{log_dir, "ct_logs"}.

%% Test specifications
{spec, fault_kill_case_SUITE}.

%% Shell configuration
{shell, [
    {apps, [sasl, crypto, public_key, ssl, gproc, cre]},
    {config, "test/sys.config"}
]}.

%% Test cover
{cover, "test/cover.spec"}.

%% Test directories
{test_dir, "test"}.

%% Auto compile
{auto_compile, true}.

%% Verbosity
{verbosity, 50}.

%% Silent connections
{silent_connections, false}.

%% Keep logs
{keep_logs, 5}.

%% Cleanup
{cleanup, true}.

%% TTY mode
{ct_hooks, [cth_surefire]}.

%% Scale log
{scale, 5000}.

%% Multiple hosts
{multiply_timetraps, 1.0}.

%% Code path
{code_path, [
    "_build/default/lib/*/ebin"
]}.

%% Include directories
{include_dirs, [
    "include",
    "src",
    "test"
]}.

%%%%====================================================================
%%% Application Configuration
%%%====================================================================

%% Logger configuration
{lager, [
    {handlers, [
        {lager_console_backend, [info]},
        {lager_file_backend, [
            {"ct_logs/error.log", error, 10485760, "$D0", 5},
            {"ct_logs/info.log", info, 10485760, "$D0", 5}
        ]}
    ]},
    {error_logger_redirect, true}
]}.

%% SASL configuration
{sasl, [
    {sasl_error_logger, false},
    {errlog_type, error},
    {error_logger_mf_dir, "ct_logs/sasl"},
    {error_logger_mf_maxbytes, 10485760},
    {error_logger_mf_maxfiles, 5}
]}.

%% CRE application configuration
{cre, [
    {test_mode, true},
    {fault_tolerance_enabled, true},
    {evidence_enabled, true},
    {supervisor_intensity, 10},
    {supervisor_period, 60}
]}.

%% GPROC configuration
{gproc, [
    {dist, all}
]}.

%%%====================================================================
%%% Fault Injection Specific Configuration
%%%====================================================================

%% Fault injector configuration
{f5_fault_injector, [
    {enabled, true},
    {fault_history_size, 100},
    {max_concurrent_faults, 10},
    {fault_timeout, 5000}
]}.

%% Case supervisor configuration
{wf_case_sup, [
    {restart_strategy, simple_one_for_one},
    {intensity, 10},
    {period, 60}
]}.

%% gen_yawl configuration
{gen_yawl, [
    {fire_timeout, 5000},
    {progress_timeout, 30000},
    {max_continue, 1000},
    {checkpoint_interval, 0}
]}.
