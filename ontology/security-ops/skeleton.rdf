<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:secops="http://cre.local/security-ops#"
  xmlns:line="http://cre.local/line#">

  <!-- Ontology Metadata -->
  <rdf:Description rdf:about="http://cre.local/security-ops">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dc:title>Security Ops Industry Ontology</dc:title>
    <dc:description>Core ontology for security incident triage and manufacturing workflow</dc:description>
    <dc:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-11T00:00:00Z</dc:created>
    <dc:creator>LineController Factory</dc:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>

  <!-- ==============================================
       CORE CLASSES
       ============================================== -->

  <!-- Incident: Primary business entity -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Incident">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Incident</rdfs:label>
    <rdfs:comment>A security incident requiring investigation, classification, and response</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Event: Raw observable or log entry -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Event</rdfs:label>
    <rdfs:comment>A raw security event or log entry from SIEM, EDR, or other source</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Gate: Decision point in the workflow -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Gate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Gate</rdfs:label>
    <rdfs:comment>A decision gate that evaluates conditions and routes incidents</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Station: Processing location/state in the workflow -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Station">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Station</rdfs:label>
    <rdfs:comment>A processing station where work is performed on an incident</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Stop: Termination point of incident flow -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Stop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Stop</rdfs:label>
    <rdfs:comment>A terminal state where incident processing ends (resolved or archived)</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Budget: Resource allocation for incident response -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Budget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Budget</rdfs:label>
    <rdfs:comment>Resource constraints (time, compute, analyst hours) for incident response</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Receipt: Audit trail entry for incident processing -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Receipt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Receipt</rdfs:label>
    <rdfs:comment>An audit log entry recording incident state transitions and actions</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- System: External system or tool (SIEM, EDR, ticketing, etc) -->
  <rdf:Description rdf:about="http://cre.local/security-ops#System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>System</rdfs:label>
    <rdfs:comment>An external system integrated with the security workflow (SIEM, EDR, etc)</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- Alert: Actionable notification triggered by incident -->
  <rdf:Description rdf:about="http://cre.local/security-ops#Alert">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Alert</rdfs:label>
    <rdfs:comment>An alert notification sent to personnel based on incident severity or classification</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- ==============================================
       CORE PROPERTIES
       ============================================== -->

  <!-- severity: Incident severity level -->
  <rdf:Description rdf:about="http://cre.local/security-ops#severity">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>severity</rdfs:label>
    <rdfs:comment>Severity level of an incident (Critical, High, Medium, Low)</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- classification: Incident type classification -->
  <rdf:Description rdf:about="http://cre.local/security-ops#classification">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>classification</rdfs:label>
    <rdfs:comment>Classification of incident type (Malware, Phishing, Recon, etc)</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- affected_systems: Systems impacted by incident -->
  <rdf:Description rdf:about="http://cre.local/security-ops#affected_systems">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>affected_systems</rdfs:label>
    <rdfs:comment>List of system identifiers affected by the incident</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- event_stream: Source event stream for incident -->
  <rdf:Description rdf:about="http://cre.local/security-ops#event_stream">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>event_stream</rdfs:label>
    <rdfs:comment>Stream identifier (SIEM, EDR, firewall) that generated the incident</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- incident_type: Type classification (alias for classification) -->
  <rdf:Description rdf:about="http://cre.local/security-ops#incident_type">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>incident_type</rdfs:label>
    <rdfs:comment>Type of incident (same as classification)</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- ==============================================
       RELATIONSHIP PROPERTIES
       ============================================== -->

  <!-- incident has events -->
  <rdf:Description rdf:about="http://cre.local/security-ops#has_events">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>has_events</rdfs:label>
    <rdfs:comment>Links an incident to raw security events</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://cre.local/security-ops#Event"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- incident has gates -->
  <rdf:Description rdf:about="http://cre.local/security-ops#has_gates">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>has_gates</rdfs:label>
    <rdfs:comment>Links an incident to decision gates in its workflow</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://cre.local/security-ops#Gate"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- incident has stations -->
  <rdf:Description rdf:about="http://cre.local/security-ops#has_stations">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>has_stations</rdfs:label>
    <rdfs:comment>Links an incident to processing stations in its workflow</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://cre.local/security-ops#Station"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- incident has audit trail -->
  <rdf:Description rdf:about="http://cre.local/security-ops#has_receipts">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>has_receipts</rdfs:label>
    <rdfs:comment>Links an incident to its audit trail receipts</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Incident"/>
    <rdfs:range rdf:resource="http://cre.local/security-ops#Receipt"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- gate has evidence requirement -->
  <rdf:Description rdf:about="http://cre.local/security-ops#evidence_required">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>evidence_required</rdfs:label>
    <rdfs:comment>Evidence items required to pass a decision gate</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Gate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- gate condition query -->
  <rdf:Description rdf:about="http://cre.local/security-ops#condition">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>condition</rdfs:label>
    <rdfs:comment>SPARQL ASK query pattern for gate evaluation</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Gate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- gate true path -->
  <rdf:Description rdf:about="http://cre.local/security-ops#true_path">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>true_path</rdfs:label>
    <rdfs:comment>Next gate or station when condition evaluates true</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Gate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- gate false path -->
  <rdf:Description rdf:about="http://cre.local/security-ops#false_path">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>false_path</rdfs:label>
    <rdfs:comment>Next gate or station when condition evaluates false</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Gate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- station operation -->
  <rdf:Description rdf:about="http://cre.local/security-ops#operation">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>operation</rdfs:label>
    <rdfs:comment>Operation performed at a station (classify, contain, investigate, escalate)</rdfs:comment>
    <rdfs:domain rdf:resource="http://cre.local/security-ops#Station"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

  <!-- timestamp property -->
  <rdf:Description rdf:about="http://cre.local/security-ops#timestamp">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>timestamp</rdfs:label>
    <rdfs:comment>ISO 8601 timestamp for events, receipts, and state transitions</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:isDefinedBy rdf:resource="http://cre.local/security-ops"/>
  </rdf:Description>

</rdf:RDF>
