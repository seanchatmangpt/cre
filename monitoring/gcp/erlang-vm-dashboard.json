{
  "displayName": "CRE Erlang VM Metrics",
  "gridLabels": {},
  "layout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Scheduler CPU Utilization",
        "xyChart": {
          "dataSets": [
            {
              "minAlignmentPeriod": "60s",
              "plotType": "LINE",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "crossSeriesReducer": "REDUCE_NONE",
                    "groupByFields": ["metric.label.scheduler_id"],
                    "perSeriesAligner": "ALIGN_RATE"
                  },
                  "filter": "resource.type=\"generic_task\" AND metric.type=\"workload.googleapis.com/erlang_scheduler/utilization\"",
                  "secondaryAggregation": {
                    "alignmentPeriod": "60s",
                    "crossSeriesReducer": "REDUCE_NONE",
                    "perSeriesAligner": "ALIGN_PERCENT_CHANGE"
                  }
                }
              }
            }
          ],
          "thresholds": [
            {
              "targetAxis": "Y1",
              "thresholdValue": 70,
              "color": "yellow"
            },
            {
              "targetAxis": "Y1",
              "thresholdValue": 90,
              "color": "red"
            }
          ],
          "yAxis": {
            "label": "Utilization %",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Runtime Utilization",
        "gaugeView": {
          "lowerBound": 0,
          "upperBound": 100
        },
        "scorecard": {
          "gaugeView": {
            "lowerBound": 0,
            "upperBound": 100
          },
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN"
                  },
                  "filter": "resource.type=\"generic_task\" AND metric.type=\"workload.googleapis.com/erlang/statistics/runtime\""
                }
              },
              "minAlignmentPeriod": "60s",
              "plotType": "HEATMAP",
              "targetAxis": "Y1"
            }
          ],
          "thresholds": {
            "colorStyle": "COLOR_STYLE_GREEN_TO_YELLOW_TO_RED",
            "thresholds": [
              {
                "direction": "DIRECTION_INCREASING",
                "value": 70
              },
              {
                "direction": "DIRECTION_INCREASING",
                "value": 90
              }
            ]
          }
        }
      },
