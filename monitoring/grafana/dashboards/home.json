    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Overall system health score",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Critical"
                },
                "1": {
                  "color": "orange",
                  "index": 1,
                  "text": "Warning"
                },
                "2": {
                  "color": "yellow",
                  "index": 2,
                  "text": "Degraded"
                },
                "3": {
                  "color": "green",
                  "index": 3,
                  "text": "Healthy"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "from": 0,
                "result": {
                  "color": "red",
                  "index": 0,
                  "text": "Critical"
                },
                "to": 50
              },
              "type": "range"
            },
            {
              "options": {
                "from": 50,
                "result": {
                  "color": "orange",
                  "index": 1,
                  "text": "Warning"
                },
                "to": 75
              },
              "type": "range"
            },
            {
              "options": {
                "from": 75,
                "result": {
                  "color": "yellow",
                  "index": 2,
                  "text": "Degraded"
                },
                "to": 90
              },
              "type": "range"
            },
            {
              "options": {
                "from": 90,
                "result": {
                  "color": "green",
                  "index": 3,
                  "text": "Healthy"
                },
                "to": 100
              },
              "type": "range"
            }
          ],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 26,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (avg(rate(cre_workflow_completed_total[5m])) / (avg(rate(cre_workflow_completed_total[5m])) + avg(rate(cre_workflow_failed_total[5m])) + 0.001))",
          "refId": "A"
        }
      ],
      "title": "System Health Score",
      "type": "gauge"
    },
