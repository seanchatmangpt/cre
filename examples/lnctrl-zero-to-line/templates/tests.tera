plan_builds_test() ->
    Plan = {{project.name}}_plan:plan(),
    ?assertMatch({seq, _}, Plan).

callback_init_test() ->
    {ok, Ctx} = {{project.name}}_cb:init(#{}),
    ?assertMatch(#{}, Ctx).

callback_plan_test() ->
    {ok, Plan, _Ctx} = {{project.name}}_cb:plan(#{}),
    ?assertMatch({seq, _}, Plan).

{% for task in tasks %}
task_{{task.taskId}}_test() ->
    Result = {{project.name}}_cb:task({{task.taskId}}, ok, #{}),
    {% if task.effectEndpoint %}
    ?assertMatch({effect, _, _, _}, Result).
    {% else %}
    ?assertMatch({ok, _, _}, Result).
    {% endif %}

{% endfor %}

unknown_task_test() ->
    Result = {{project.name}}_cb:task(unknown_task_id, ok, #{}),
    ?assertMatch({error, {unknown_task, unknown_task_id}, _}, Result).

