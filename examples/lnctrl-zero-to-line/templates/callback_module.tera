%%% @doc Generated ln_ctrl callback module for {{project.name}}
%%% DO NOT EDIT - Generated by ggen from ontology/order_line.ttl
%%% Generation timestamp: {{timestamp}}
-module({{project.name}}_cb).

-behaviour(ln_ctrl).

-export([init/1, plan/1, task/3, effect_result/4]).

%%% ===========================================================================
%%% ln_ctrl CALLBACKS
%%% ===========================================================================

%% @doc Initialize case context
-spec init(map()) -> {ok, map()}.
init(InitialCtx) ->
    {ok, InitialCtx}.

%% @doc Return the plan for this line
-spec plan(map()) -> {ok, ln_ctrl:plan(), map()}.
plan(Ctx) ->
    Plan = {{project.name}}_plan:plan(),
    {ok, Plan, Ctx}.

%% @doc Handle task execution
-spec task(atom(), any(), map()) -> ln_ctrl:task_result().
{% for task in tasks %}
task({{task.taskId}}, _Input, Ctx) ->
    %% {{task.taskDescription}}
    {% if task.effectEndpoint %}
    %% Effect: {{task.effectType}} {{task.effectEndpoint}}
    EffectSpec = #{
        type => {{task.effectType}},
        endpoint => <<"{{task.effectEndpoint}}">>,
        data => maps:get({{task.taskId}}_data, Ctx, #{})
    },
    Cont = fun(Result) -> {ok, Result} end,
    {effect, EffectSpec, Cont, Ctx};
    {% else %}
    %% No effect - direct result
    {ok, ok, Ctx};
    {% endif %}
{% endfor %}
task(TaskId, _Input, Ctx) ->
    %% Unknown task
    {error, {unknown_task, TaskId}, Ctx}.

%% @doc Handle effect result
-spec effect_result(atom(), any(), any(), map()) -> {ok, any(), map()} | {error, any(), map()}.
effect_result(_TaskId, _EffectSpec, Result, Ctx) ->
    %% Default: pass through effect result
    {ok, Result, Ctx}.
