reg:check_automated_decision_rights a reg:Check ;
    reg:checkId "automated_decision_rights" ;
    rdfs:label "Automated Decision Rights" ;
    rdfs:comment "Right to opt out of automated decision-making" .

reg:check_correction_rights a reg:Check ;
