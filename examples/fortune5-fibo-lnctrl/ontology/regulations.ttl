    reg:severity "high" ;
    reg:requiresCheck reg:check_data_deletion_rights ;
    reg:requiresCheck reg:check_opt_out_sale ;
    reg:requiresCheck reg:check_disclosure_collection .

reg:check_data_deletion_rights a reg:Check ;
    reg:checkId "data_deletion_rights" ;
    rdfs:label "Data Deletion Rights" ;
    rdfs:comment "Right to request deletion of personal information" .

reg:check_opt_out_sale a reg:Check ;
    reg:checkId "opt_out_sale" ;
    rdfs:label "Opt-Out of Sale" ;
    rdfs:comment "Right to opt out of sale of personal information" .

reg:check_disclosure_collection a reg:Check ;
    reg:checkId "disclosure_collection" ;
    rdfs:label "Disclosure of Collection" ;
    rdfs:comment "Disclosure of personal information collection practices" .

# California Privacy Rights Act (CPRA)
reg:ca_cpra a reg:Regulation ;
    reg:regulationId "ca_cpra" ;
    reg:regulationName "California Privacy Rights Act" ;
    reg:severity "high" ;
    reg:requiresCheck reg:check_sensitive_data_limits ;
