@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix reg: <http://fortune5.lnctrl.io/regulations#> .
@prefix ln: <http://lnctrl.io/ontology#> .

# ============================================================================
# Regulation Ontology - Fortune-5 Financial Services Compliance
# ============================================================================

reg:Regulation a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:comment "A financial regulation that must be enforced" .

reg:Check a owl:Class ;
    rdfs:label "Regulatory Check" ;
    rdfs:comment "A specific compliance check required by a regulation" .

reg:regulationId a owl:DatatypeProperty ;
    rdfs:domain reg:Regulation ;
    rdfs:range xsd:string .

reg:regulationName a owl:DatatypeProperty ;
    rdfs:domain reg:Regulation ;
    rdfs:range xsd:string .

reg:severity a owl:DatatypeProperty ;
    rdfs:domain reg:Regulation ;
    rdfs:range xsd:string .

reg:requiresCheck a owl:ObjectProperty ;
    rdfs:domain reg:Regulation ;
    rdfs:range reg:Check .

reg:checkId a owl:DatatypeProperty ;
    rdfs:domain reg:Check ;
    rdfs:range xsd:string .

# ============================================================================
# Federal Regulations
# ============================================================================

# Bank Secrecy Act / Anti-Money Laundering
reg:fed_bsa_aml a reg:Regulation ;
    reg:regulationId "fed_bsa_aml" ;
    reg:regulationName "Bank Secrecy Act / Anti-Money Laundering" ;
    reg:severity "critical" ;
    reg:requiresCheck reg:check_kyc_verification ;
    reg:requiresCheck reg:check_sar_filing ;
    reg:requiresCheck reg:check_ctr_reporting ;
    reg:requiresCheck reg:check_suspicious_activity_monitoring .

reg:check_kyc_verification a reg:Check ;
    reg:checkId "kyc_verification" ;
    rdfs:label "KYC Verification" ;
    rdfs:comment "Know Your Customer identity verification" .

reg:check_sar_filing a reg:Check ;
    reg:checkId "sar_filing" ;
    rdfs:label "SAR Filing" ;
    rdfs:comment "Suspicious Activity Report filing requirements" .

reg:check_ctr_reporting a reg:Check ;
    reg:checkId "ctr_reporting" ;
    rdfs:label "CTR Reporting" ;
    rdfs:comment "Currency Transaction Report for transactions over $10,000" .

reg:check_suspicious_activity_monitoring a reg:Check ;
    reg:checkId "suspicious_activity_monitoring" ;
    rdfs:label "Suspicious Activity Monitoring" ;
    rdfs:comment "Continuous monitoring for suspicious patterns" .

# Federal Regulation E (Electronic Fund Transfers)
reg:fed_cfpb_reg_e a reg:Regulation ;
    reg:regulationId "fed_cfpb_reg_e" ;
    reg:regulationName "Federal Regulation E (Electronic Fund Transfers)" ;
    reg:severity "critical" ;
    reg:requiresCheck reg:check_error_resolution ;
    reg:requiresCheck reg:check_unauthorized_transfer_liability ;
    reg:requiresCheck reg:check_disclosure_requirements .

reg:check_error_resolution a reg:Check ;
    reg:checkId "error_resolution" ;
    rdfs:label "Error Resolution" ;
    rdfs:comment "Process for resolving electronic transfer errors" .

reg:check_unauthorized_transfer_liability a reg:Check ;
    reg:checkId "unauthorized_transfer_liability" ;
    rdfs:label "Unauthorized Transfer Liability" ;
    rdfs:comment "Liability limits for unauthorized electronic transfers" .

reg:check_disclosure_requirements a reg:Check ;
    reg:checkId "disclosure_requirements" ;
    rdfs:label "Disclosure Requirements" ;
    rdfs:comment "Required disclosures for electronic fund transfer services" .

# Federal Regulation Z (Truth in Lending)
reg:fed_cfpb_reg_z a reg:Regulation ;
    reg:regulationId "fed_cfpb_reg_z" ;
    reg:regulationName "Federal Regulation Z (Truth in Lending)" ;
    reg:severity "critical" ;
    reg:requiresCheck reg:check_apr_disclosure ;
    reg:requiresCheck reg:check_rescission_rights ;
    reg:requiresCheck reg:check_billing_error_resolution .

reg:check_apr_disclosure a reg:Check ;
    reg:checkId "apr_disclosure" ;
    rdfs:label "APR Disclosure" ;
    rdfs:comment "Annual Percentage Rate disclosure requirements" .

reg:check_rescission_rights a reg:Check ;
    reg:checkId "rescission_rights" ;
    rdfs:label "Rescission Rights" ;
    rdfs:comment "Three-day right to cancel certain credit transactions" .

reg:check_billing_error_resolution a reg:Check ;
    reg:checkId "billing_error_resolution" ;
    rdfs:label "Billing Error Resolution" ;
    rdfs:comment "Process for resolving billing disputes" .

# TRID (TILA-RESPA Integrated Disclosures)
reg:fed_cfpb_trid a reg:Regulation ;
    reg:regulationId "fed_cfpb_trid" ;
    reg:regulationName "TRID (TILA-RESPA Integrated Disclosures)" ;
    reg:severity "critical" ;
    reg:requiresCheck reg:check_loan_estimate_accuracy ;
    reg:requiresCheck reg:check_closing_disclosure_timing ;
    reg:requiresCheck reg:check_fee_tolerance_limits .

reg:check_loan_estimate_accuracy a reg:Check ;
    reg:checkId "loan_estimate_accuracy" ;
    rdfs:label "Loan Estimate Accuracy" ;
    rdfs:comment "Accuracy requirements for initial loan estimates" .

reg:check_closing_disclosure_timing a reg:Check ;
    reg:checkId "closing_disclosure_timing" ;
    rdfs:label "Closing Disclosure Timing" ;
    rdfs:comment "Timing requirements for final closing disclosures" .

reg:check_fee_tolerance_limits a reg:Check ;
    reg:checkId "fee_tolerance_limits" ;
    rdfs:label "Fee Tolerance Limits" ;
    rdfs:comment "Allowed variance between estimated and actual fees" .

# ============================================================================
# State Regulations
# ============================================================================

# New York DFS Cybersecurity Regulation (23 NYCRR 500)
reg:ny_dfs_23_nycrr_500 a reg:Regulation ;
    reg:regulationId "ny_dfs_23_nycrr_500" ;
    reg:regulationName "NY DFS Cybersecurity Regulation (23 NYCRR 500)" ;
    reg:severity "critical" ;
    reg:requiresCheck reg:check_audit_trail ;
    reg:requiresCheck reg:check_access_controls ;
    reg:requiresCheck reg:check_penetration_testing ;
    reg:requiresCheck reg:check_incident_response .

reg:check_audit_trail a reg:Check ;
    reg:checkId "audit_trail" ;
    rdfs:label "Audit Trail" ;
    rdfs:comment "Comprehensive logging of system access and changes" .

reg:check_access_controls a reg:Check ;
    reg:checkId "access_controls" ;
    rdfs:label "Access Controls" ;
    rdfs:comment "Multi-factor authentication and role-based access" .

reg:check_penetration_testing a reg:Check ;
    reg:checkId "penetration_testing" ;
    rdfs:label "Penetration Testing" ;
    rdfs:comment "Regular security testing and vulnerability assessments" .

reg:check_incident_response a reg:Check ;
    reg:checkId "incident_response" ;
    rdfs:label "Incident Response" ;
    rdfs:comment "Documented incident response procedures" .

# California Consumer Privacy Act (CCPA)
reg:ca_ccpa a reg:Regulation ;
    reg:regulationId "ca_ccpa" ;
