%% Test module for {{ appId }}
%% DO NOT EDIT - Generated by Fortune-5 FIBO LineController Factory

-module({{ appId }}_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("eunit/include/eunit.hrl").

%% Common Test callbacks
-export([all/0, init_per_suite/1, end_per_suite/1]).
-export([test_app_start/1, test_supervisor_children/1, test_worker_process/1]).

%%% Common Test callbacks

all() ->
    [test_app_start, test_supervisor_children, test_worker_process].

init_per_suite(Config) ->
    application:ensure_all_started({{ appId }}),
    Config.

end_per_suite(_Config) ->
    application:stop({{ appId }}),
    ok.

%%% Test cases

test_app_start(_Config) ->
    {ok, Apps} = application:ensure_all_started({{ appId }}),
    ?assert(lists:member({{ appId }}, Apps)),
    ok.

test_supervisor_children(_Config) ->
    Children = supervisor:which_children({{ appId }}_sup),
    ?assert(length(Children) > 0),
    ok.

test_worker_process(_Config) ->
    Result = {{ appId }}_worker:process(#{test => true}),
    ?assertMatch({ok, _}, Result),
    ok.
