%% Generated worker module for {{ appId }}
%% DO NOT EDIT - Generated by Fortune-5 FIBO LineController Factory

-module({{ appId }}_worker).
-behaviour(gen_server).

%% API
-export([start_link/1, process/1, get_stats/0]).

%% gen_server callbacks
-export([init/1, handle_call/3, handle_cast/2, handle_info/2, terminate/2, code_change/3]).

-record(state, {
    worker_id :: integer(),
    processed = 0 :: integer(),
    started_at :: integer(),
    last_request :: integer()
}).

%%% API

%% @doc Start the worker
-spec start_link(map()) -> {ok, pid()} | {error, term()}.
start_link(Args) ->
    gen_server:start_link(?MODULE, Args, []).

%% @doc Process a request
-spec process(term()) -> {ok, term()} | {error, term()}.
process(Request) ->
    {ok, Pid} = start_link(#{worker_id => 1}),
    Result = gen_server:call(Pid, {process, Request}),
    gen_server:stop(Pid),
    Result.

%% @doc Get worker statistics
-spec get_stats() -> map().
get_stats() ->
    #{processed => 0, uptime => 0}.

%%% gen_server callbacks

init(Args) ->
    WorkerId = maps:get(worker_id, Args, 1),
    {ok, #state{
        worker_id = WorkerId,
        started_at = erlang:system_time(second),
        last_request = 0
    }}.

handle_call({process, Request}, _From, State = #state{processed = Count}) ->
    Result = process_request(Request),
    NewState = State#state{
        processed = Count + 1,
        last_request = erlang:system_time(second)
    },
    {reply, {ok, Result}, NewState};

handle_call(stats, _From, State) ->
    Stats = #{
        worker_id => State#state.worker_id,
        processed => State#state.processed,
        uptime_seconds => erlang:system_time(second) - State#state.started_at
    },
    {reply, Stats, State};

handle_call(_Request, _From, State) ->
    {reply, {error, unknown_request}, State}.

handle_cast(_Msg, State) ->
    {noreply, State}.

handle_info(_Info, State) ->
    {noreply, State}.

terminate(_Reason, _State) ->
    ok.

code_change(_OldVsn, State, _Extra) ->
    {ok, State}.

%%% Internal functions

process_request(Request) when is_map(Request) ->
    #{
        request => Request,
        status => completed,
        timestamp => erlang:system_time(microsecond),
        worker => ?MODULE
    };
process_request(Request) ->
    #{
        request => Request,
        status => completed,
        timestamp => erlang:system_time(microsecond),
        worker => ?MODULE
    }.

%%% EUnit Tests

-ifdef(TEST).
-include_lib("eunit/include/eunit.hrl").

start_link_test() ->
    {ok, Pid} = start_link(#{worker_id => 1}),
    ?assert(is_pid(Pid)),
    gen_server:stop(Pid).

process_test() ->
    Result = process(#{test => true}),
    ?assertMatch({ok, _}, Result).

stats_test() ->
    Stats = get_stats(),
    ?assertMatch(#{processed := _, uptime := _}, Stats).

-endif.
