-module({{ appId }}_{{ moduleId }}).

%% API exports
-export([process/1, validate/1, transform/1]).

%%% API

%% @doc Process data through the module pipeline
-spec process(term()) -> {ok, map()} | {error, term()}.
process(Data) ->
    try
        Validated = validate(Data),
        Transformed = transform(Validated),
        {ok, Transformed}
    catch
        error:Reason ->
            {error, Reason}
    end.

%% @doc Validate input data
-spec validate(term()) -> map().
validate(Data) when is_map(Data) ->
    Data;
validate(_) ->
    error(invalid_data).

%% @doc Transform validated data
-spec transform(map()) -> map().
transform(Data) ->
    #{
        result => ok,
        data => Data,
        timestamp => erlang:system_time(microsecond),
        module => ?MODULE
    }.

%%% EUnit Tests

-ifdef(TEST).
-include_lib("eunit/include/eunit.hrl").

process_test() ->
    Result = process(#{test => true}),
    ?assertMatch({ok, #{result := ok}}, Result).

validate_map_test() ->
    Result = validate(#{test => true}),
    ?assertMatch(#{test := true}, Result).

validate_invalid_test() ->
    ?assertError(invalid_data, validate(not_a_map)).

transform_test() ->
    Result = transform(#{test => true}),
    ?assertMatch(#{result := ok, data := _, timestamp := _, module := _}, Result).

-endif.
