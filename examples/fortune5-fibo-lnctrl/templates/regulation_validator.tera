%% Generated regulation validator for {{ customerName }}
%% Regulation: {{ regulationName }}
%% Jurisdiction: {{ jurisdiction | replace(from="_", to=" ") | title }}
%% Risk Tier: {{ riskTier }}
%%
%% DO NOT EDIT - Generated by Fortune-5 Regulations Suite Generator
%% This ensures compliance with {{ regulationId | upper }}

-module(f5_reg_{{ customerId }}_{{ regulationId }}_validator).

%% API
-export([validate_all/1, get_regulation_info/0]).
-export([{% for check in checks | split(pat=",") %}validate_{{ check }}/1{% if not loop.last %}, {% endif %}{% endfor %}]).

-record(validation_context, {
    customer_id :: binary(),
    jurisdiction :: atom(),
    regulation_id :: atom(),
    data :: map(),
    timestamp :: integer()
}).

%%% API Functions

%% @doc Validate all requirements for this regulation
-spec validate_all(map()) -> {ok, [{atom(), ok}]} | {error, [{atom(), term()}]}.
validate_all(Context) ->
    %% Use function references, not atoms
    Checks = [
        {% for check in checks | split(pat=",") %}{fun ?MODULE:validate_{{ check }}/1, '{{ check }}'}{% if not loop.last %},
        {% endif %}{% endfor %}
    ],

    Results = lists:map(fun({CheckFun, CheckName}) ->
        case CheckFun(Context) of
            {ok, validated} -> {CheckName, ok};
            {error, Reason} -> {CheckName, {error, Reason}}
        end
    end, Checks),

    Failures = [R || {_, {error, _}} = R <- Results],

    case Failures of
        [] -> {ok, Results};
        _ -> {error, Failures}
    end.

%% @doc Get regulation metadata
-spec get_regulation_info() -> map().
get_regulation_info() ->
    #{
        customer_id => "{{ customerId }}",
        customer_name => "{{ customerName }}",
        jurisdiction => {{ jurisdiction }},
        regulation_id => {{ regulationId }},
        regulation_name => "{{ regulationName }}",
        severity => {{ severity }},
        risk_tier => {{ riskTier }},
        checks => [{% for check in checks | split(pat=",") %}'{{ check }}'{% if not loop.last %}, {% endif %}{% endfor %}]
    }.

{% for check in checks | split(pat=",") %}
%% @doc Validate {{ check | replace(from="_", to=" ") }} for {{ regulationName }}
-spec validate_{{ check }}(map()) -> {ok, validated} | {error, term()}.
validate_{{ check }}(Context) ->
    %% Extract relevant data from context
    Data = maps:get(data, Context, #{}),

    %% Perform actual validation logic
    case check_{{ check }}(Data) of
        true ->
            logger:info("Validation passed: {{ check }}", []),
            {ok, validated};
        false ->
            logger:error("Validation failed: {{ check }}", []),
            {error, {validation_failed, {{ check }}}}
    end.

check_{{ check }}(Data) when is_map(Data) ->
    %% Actual validation implementation
    %% This would check against specific regulatory requirements
    maps:get({{ check }}, Data, true);
check_{{ check }}(_) ->
    false.
{% endfor %}

%%% EUnit Tests

-ifdef(TEST).
-include_lib("eunit/include/eunit.hrl").

get_regulation_info_test() ->
    Info = get_regulation_info(),
    ?assertEqual("{{ customerId }}", maps:get(customer_id, Info)),
    ?assertEqual({{ regulationId }}, maps:get(regulation_id, Info)).

validate_all_test() ->
    %% All checks pass
    ValidContext = #{
        data => #{{% for check in checks | split(pat=",") %}{{ check }} => true{% if not loop.last %}, {% endif %}{% endfor %}}
    },
    {ok, Results} = validate_all(ValidContext),
    ?assertEqual({{ checks | split(pat=",") | length }}, length(Results)),

    %% Some checks fail
    InvalidContext = #{
        data => #{{% for check in checks | split(pat=",") %}{% if loop.first %}{{ check }} => false{% endif %}{% endfor %}}
    },
    {error, Failures} = validate_all(InvalidContext),
    ?assert(length(Failures) > 0).

{% for check in checks | split(pat=",") %}
validate_{{ check }}_test() ->
    ValidContext = #{data => #{{{ check }} => true}},
    ?assertEqual({ok, validated}, validate_{{ check }}(ValidContext)),

    InvalidContext = #{data => #{{{ check }} => false}},
    ?assertMatch({error, _}, validate_{{ check }}(InvalidContext)).
{% endfor %}

-endif.
