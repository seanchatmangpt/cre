%% Generated regulation suite supervisor for {{ customerName }}
-module(f5_reg_{{ customerId }}_sup).
-behaviour(supervisor).

-export([start_link/0, init/1]).

start_link() ->
    supervisor:start_link({local, ?MODULE}, ?MODULE, []).

init([]) ->
    SupFlags = #{
        strategy => one_for_all,  %% All regulations must pass
        intensity => 3,
        period => 60
    },

    %% Start validators for each regulation
    ChildSpecs = [
        {% for reg in regulations | split(pat=",") %}#{
            id => {{ reg }}_validator,
            start => {f5_reg_{{ customerId }}_{{ reg }}_validator, start_link, []},
            restart => permanent,
            shutdown => 5000,
            type => worker
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ],

    {ok, {SupFlags, ChildSpecs}}.
