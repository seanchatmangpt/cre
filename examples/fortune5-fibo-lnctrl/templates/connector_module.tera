rate_limit_test() ->
    {ok, _} = start_link(),
    %% Should succeed within rate limit
    Results = [{{ operations[0] | lower }}(#{test => I}) || I <- lists:seq(1, 10)],
    ?assert(lists:all(fun({ok, _}) -> true; (_) -> false end, Results)),
    stop().

-endif.
