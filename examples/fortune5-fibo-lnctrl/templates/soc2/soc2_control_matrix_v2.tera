# SOC 2 Control Matrix
# Generated by ggen sync from ontology
# DO NOT EDIT - All changes will be overwritten

suites:
{% set ns = namespace(suite="", category="", control="", validators=[], evidence=[]) -%}
{% for row in rows -%}
  {%- if row.suiteId != ns.suite -%}
    {%- if ns.suite != "" %}
      # Close previous control/category/suite
    {%- endif %}
    {%- set ns.suite = row.suiteId %}
    {%- set ns.category = "" %}
    {%- set ns.control = "" %}
  - suite_id: {{ row.suiteId }}
    suite_name: "{{ row.suiteName }}"
    categories:
  {%- endif %}
  {%- if row.tscId != ns.category %}
    {%- set ns.category = row.tscId %}
    {%- set ns.control = "" %}
      - category_id: {{ row.tscId }}
        category_name: "{{ row.tscLabel }}"
        controls:
  {%- endif %}
  {%- if row.controlId != ns.control %}
    {%- set ns.control = row.controlId %}
          - control_id: "{{ row.controlId }}"
            title: "{{ row.controlTitle }}"
            description: "{{ row.controlDescription }}"
            validators:
              - "{{ row.validatorId }}"
            evidence:
              - evidence_id: {{ row.evidenceId }}
                path: "{{ row.evidencePath }}"
                format: {{ row.evidenceFormat }}
                integrity: {{ row.evidenceIntegrity }}
                {% if row.retentionDays -%}retention_days: {{ row.retentionDays }}{%- endif %}
  {%- else %}
              - "{{ row.validatorId }}"
  {%- endif %}
{% endfor %}
