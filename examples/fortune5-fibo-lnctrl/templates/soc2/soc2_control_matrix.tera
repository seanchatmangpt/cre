# SOC 2 Control Matrix
# Generated by ggen sync from ontology
# DO NOT EDIT - All changes will be overwritten

{% set current_suite = "" %}
{% set current_category = "" %}
{% set current_control = "" %}

suites:
{% for row in rows %}
  {%- if row.suiteId != current_suite %}
  {%- set_global current_suite = row.suiteId %}
  {%- set_global current_category = "" %}
  {%- set_global current_control = "" %}
  - suite_id: {{ row.suiteId }}
    suite_name: "{{ row.suiteName }}"
    categories:
  {%- endif %}
  {%- if row.tscId != current_category %}
  {%- set_global current_category = row.tscId %}
  {%- set_global current_control = "" %}
      - category_id: {{ row.tscId }}
        category_name: "{{ row.tscLabel }}"
        controls:
  {%- endif %}
  {%- if row.controlId != current_control %}
  {%- set_global current_control = row.controlId %}
          - control_id: "{{ row.controlId }}"
            title: "{{ row.controlTitle }}"
            description: "{{ row.controlDescription }}"
            validators:
              - {{ row.validatorId }}
            evidence:
              - evidence_id: {{ row.evidenceId }}
                path: "{{ row.evidencePath }}"
                format: {{ row.evidenceFormat }}
                integrity: {{ row.evidenceIntegrity }}
                {%- if row.retentionDays %}
                retention_days: {{ row.retentionDays }}
                {%- endif %}
  {%- else %}
            {%- if row.validatorId %}
              - {{ row.validatorId }}
            {%- endif %}
            {%- if row.evidenceId %}
              - evidence_id: {{ row.evidenceId }}
                path: "{{ row.evidencePath }}"
                format: {{ row.evidenceFormat }}
                integrity: {{ row.evidenceIntegrity }}
                {%- if row.retentionDays %}
                retention_days: {{ row.retentionDays }}
                {%- endif %}
            {%- endif %}
  {%- endif %}
{% endfor %}
