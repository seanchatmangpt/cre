%% Service worker for {{ connectorId }}
%% DO NOT EDIT - Generated by Fortune-5 FIBO LineController Factory

-module(f5_service_{{ connectorId }}_worker).
-behaviour(gen_server).

%% API
-export([start_link/1, process/1]).

%% gen_server callbacks
-export([init/1, handle_call/3, handle_cast/2, handle_info/2, terminate/2, code_change/3]).

-record(state, {
    connector_id :: atom(),
    processed = 0 :: integer(),
    started_at :: integer()
}).

%%% API

%% @doc Start the service worker
-spec start_link(map()) -> {ok, pid()} | {error, term()}.
start_link(Args) ->
    gen_server:start_link(?MODULE, Args, []).

%% @doc Process a service request
-spec process(map()) -> {ok, map()} | {error, term()}.
process(Request) ->
    {ok, Pid} = start_link(#{connector_id => {{ connectorId }}}),
    Result = gen_server:call(Pid, {process, Request}),
    gen_server:stop(Pid),
    Result.

%%% gen_server callbacks

init(Args) ->
    ConnectorId = maps:get(connector_id, Args, {{ connectorId }}),
    {ok, #state{
        connector_id = ConnectorId,
        started_at = erlang:system_time(second)
    }}.

handle_call({process, Request}, _From, State = #state{processed = Count}) ->
    Result = execute_service(Request),
    NewState = State#state{processed = Count + 1},
    {reply, {ok, Result}, NewState};

handle_call(stats, _From, State) ->
    Stats = #{
        connector_id => State#state.connector_id,
        processed => State#state.processed,
        uptime_seconds => erlang:system_time(second) - State#state.started_at
    },
    {reply, Stats, State};

handle_call(_Request, _From, State) ->
    {reply, {error, unknown_request}, State}.

handle_cast(_Msg, State) ->
    {noreply, State}.

handle_info(_Info, State) ->
    {noreply, State}.

terminate(_Reason, _State) ->
    ok.

code_change(_OldVsn, State, _Extra) ->
    {ok, State}.

%%% Internal functions

execute_service(Request) when is_map(Request) ->
    RequestId = generate_request_id(),
    Timestamp = erlang:system_time(microsecond),

    ProcessedData = process_request_data(Request),

    #{
        request_id => RequestId,
        connector_id => {{ connectorId }},
        status => completed,
        timestamp => Timestamp,
        data => ProcessedData,
        processing_time_us => erlang:system_time(microsecond) - Timestamp
    }.

process_request_data(Request) when is_map(Request) ->
    maps:fold(fun(K, V, Acc) ->
        ProcessedValue = case K of
            amount when is_number(V) -> V * 1.0;
            status when is_atom(V) -> V;
            _ -> V
        end,
        Acc#{K => ProcessedValue}
    end, #{}, Request);
process_request_data(Request) ->
    #{raw => Request}.

generate_request_id() ->
    list_to_binary([
        integer_to_list(erlang:system_time(microsecond)),
        "-",
        integer_to_list(erlang:unique_integer([positive]))
    ]).

%%% EUnit Tests

-ifdef(TEST).
-include_lib("eunit/include/eunit.hrl").

start_link_test() ->
    {ok, Pid} = start_link(#{connector_id => {{ connectorId }}}),
    ?assert(is_pid(Pid)),
    gen_server:stop(Pid).

process_test() ->
    Result = process(#{test => true}),
    ?assertMatch({ok, #{status := completed}}, Result).

-endif.
