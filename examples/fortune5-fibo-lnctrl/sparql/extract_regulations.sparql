PREFIX ln: <http://lnctrl.io/ontology#>
PREFIX f5: <http://fortune5.lnctrl.io/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?customerId ?jurisdiction ?regulationType ?validationRules
WHERE {
    ?customer a ln:Customer ;
              ln:customerId ?customerId ;
              ln:jurisdiction ?jurisdiction ;
              ln:regulationType ?regulationType .

    OPTIONAL {
        ?customer ln:validationRules ?validationRules .
    }
}
ORDER BY ?customerId ?regulationType
